# Build / install artifacts
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
.venv/

# PoLiMa outputs -- bundles, ONNX, ELFs and checkpoints are content-addressed
# build products, never source.
outputs/
*.onnx
*.elf
*.f32
*.npz
*_mpk.tar.gz

# Local site config (board address etc.); .polima.yaml.example is tracked.
.polima.yaml
.polima.json

# PoLiMa Studio host-side frontend dependencies; production assets are built
# into src/polima/studio/static and shipped in the board wheel.
src/polima/studio/ui/node_modules/

# Local release notes
/CHANGELOG.md
